# ============================================================
# GAPAI MENTORSHIP — ENVIRONMENT CONFIGURATION
# ============================================================

# Base URL website tanpa trailing slash.
#
# Local development:
VITE_SITE_URL=http://localhost:3000

# Jangan izinkan indexing selama development dan proses review.
VITE_ALLOW_INDEXING=false

# ============================================================
# CONTOH KONFIGURASI VERCEL SEBELUM DOMAIN FINAL
# ============================================================
#
# VITE_SITE_URL=https://nama-project.vercel.app
# VITE_ALLOW_INDEXING=false

# ============================================================
# KONFIGURASI SETELAH GapaiHub.com DISETUJUI DAN TERPASANG
# ============================================================
#
# VITE_SITE_URL=https://gapaithub.com
# VITE_ALLOW_INDEXING=true